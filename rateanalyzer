<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vyne Dental Savings Calculator</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }
        .container {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
            text-align: center;
        }
        input {
            width: 100px;
            margin: 5px;
            padding: 8px;
        }
        button {
            padding: 10px 15px;
            background-color: #007BFF;
            color: white;
            border: none;
            cursor: pointer;
            margin-top: 10px;
        }
        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Vyne Dental Savings Calculator</h2>
        <p>Enter your last 3 months of merchant service statements:</p>
        <div>
            <label>Month 1 Charges:</label>
            <input type="number" id="month1Charges" placeholder="$">
            <label>Costs:</label>
            <input type="number" id="month1Costs" placeholder="$">
        </div>
        <div>
            <label>Month 2 Charges:</label>
            <input type="number" id="month2Charges" placeholder="$">
            <label>Costs:</label>
            <input type="number" id="month2Costs" placeholder="$">
        </div>
        <div>
            <label>Month 3 Charges:</label>
            <input type="number" id="month3Charges" placeholder="$">
            <label>Costs:</label>
            <input type="number" id="month3Costs" placeholder="$">
        </div>
        <button onclick="calculateSavings()">Calculate Savings</button>
        <h3 id="result"></h3>
    </div>

    <script>
        function calculateSavings() {
            let charges = [
                parseFloat(document.getElementById("month1Charges").value) || 0,
                parseFloat(document.getElementById("month2Charges").value) || 0,
                parseFloat(document.getElementById("month3Charges").value) || 0
            ];

            let costs = [
                parseFloat(document.getElementById("month1Costs").value) || 0,
                parseFloat(document.getElementById("month2Costs").value) || 0,
                parseFloat(document.getElementById("month3Costs").value) || 0
            ];

            let totalCharges = charges.reduce((a, b) => a + b, 0);
            let totalCosts = costs.reduce((a, b) => a + b, 0);
            let currentEffectiveRate = (totalCosts / totalCharges) * 100;
            let vyneRate = 2.5; // Example Vyne Dental effective rate
            let vyneCosts = (totalCharges * vyneRate) / 100;
            let savings = totalCosts - vyneCosts;

            document.getElementById("result").innerText = savings > 0 
                ? `You could save approximately $${savings.toFixed(2)} with Vyne Dental!`
                : "No significant savings detected. Let's talk about your needs!";
        }
    </script>
</body>
</html>
